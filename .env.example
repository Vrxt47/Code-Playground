# ===============================================
# Code Playground - Environment Configuration Template
# ===============================================
# Copy this file to '.env' and populate with your own secret values.
# NEVER commit your actual '.env' file containing real secrets to version control.

# 1. Server Port (Default: 4000)
# Auto-assigned by cloud hosts (Render, Railway, Heroku)
PORT=4000

# 2. Environment Mode ('development' | 'production' | 'test')
# In 'production' mode, a valid, secure JWT_SECRET of at least 32 characters is strictly required.
NODE_ENV=development

# 3. MongoDB Connection String
# Local Instance: mongodb://127.0.0.1:27017/codeplayground
# Cloud (MongoDB Atlas Free Tier):
# mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/codeplayground?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codeplayground

# 4. JWT Secret Key (For User Authentication & Sessions)
# MANDATORY in production: Must be at least 32 characters long.
# Generate a cryptographically secure random key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_32_character_minimum_random_secret_here

# 5. Allowed CORS Origins (Comma-separated list of permitted external origins)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Local development origins (localhost:3000, 4000, 5000) are permitted by default.
ALLOWED_ORIGINS=

# 6. Code Execution Engine Mode
# 'cloud' -> Cloud sandboxing via Wandbox / Piston API (Default & recommended for security)
# 'auto'  -> Cloud execution with sandboxed remote fallbacks
EXECUTION_MODE=cloud

# 7. Optional: Custom Piston API URL & API Key (if self-hosting Piston or using token)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
PISTON_API_KEY=

